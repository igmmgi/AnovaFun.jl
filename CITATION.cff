cff-version: 1.2.0
message: "If you use this software, please cite it as below."
type: software
title: "AnovaFun.jl"
version: "0.3.0"
doi: "10.5281/zenodo.18139228"
date-released: "2026-03-11"
url: "https://github.com/igmmgi/AnovaFun.jl"
repository-code: "https://github.com/igmmgi/AnovaFun.jl"
license: MIT
abstract: >-
  A Julia package for analysis of factorial experiments, including repeated
  measures (within-subjects), between-subjects, and mixed designs. Features
  include estimated marginal means, pairwise comparisons, sphericity
  corrections, effect sizes, power analysis, and publication-quality plots.
